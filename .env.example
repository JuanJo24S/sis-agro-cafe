# Copia este archivo como .env antes de levantar el sistema:  cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=agrocafe
POSTGRES_PASSWORD=agrocafe
# Base administrativa; cada microservicio usa la suya (ver infra/postgres/init).
POSTGRES_DB=agrocafe

# --- Seguridad (JWT compartido entre ms-auth y los demas microservicios) ---
# Minimo 32 caracteres. Generar uno propio con:  openssl rand -base64 48
JWT_SECRET=cambiar-este-secreto-por-uno-largo-y-aleatorio-de-al-menos-32
JWT_EXPIRACION_SEGUNDOS=3600

# --- Puertos publicados en el host ---
# Cambialos solo si alguno ya esta ocupado en tu maquina.
PUERTO_FRONTEND=15173
PUERTO_GATEWAY=18080
PUERTO_AUTH=18081
PUERTO_AGRONOMICO=18082
PUERTO_COSECHA=18083
PUERTO_FINANCIERO=18084
PUERTO_POSTGRES=15432
PUERTO_KAFKA=19092

# --- Trazas (Jaeger) ---
PUERTO_JAEGER=18686
PUERTO_OTLP_HTTP=14318

# --- Observabilidad (Prometheus / Grafana) ---
PUERTO_PROMETHEUS=19090
PUERTO_GRAFANA=13000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Kafka UI ---
PUERTO_KAFKA_UI=18085
