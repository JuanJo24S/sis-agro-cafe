{
  "info": {
    "name": "ms-auth",
    "description": "Autenticacion y gestion de usuarios — puerto 8081",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:18081" },
    { "key": "token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/registro",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "registro"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Caficultor\",\n  \"email\": \"juan@example.com\",\n  \"password\": \"secreto123\",\n  \"rol\": \"CAFICULTOR\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@example.com\",\n  \"password\": \"secreto123\"\n}"
            }
          }
        },
        {
          "name": "Cambiar password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/cambiar-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "cambiar-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passwordActual\": \"secreto123\",\n  \"passwordNueva\": \"nuevoSecreto456\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Obtener perfil propio",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/usuarios/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "usuarios", "me"]
            }
          }
        },
        {
          "name": "Actualizar perfil",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/usuarios/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "usuarios", "me"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Actualizado\"\n}"
            }
          }
        },
        {
          "name": "Cambiar estado cuenta (activar/desactivar)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/usuarios/me/estado",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "usuarios", "me", "estado"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"INACTIVO\"\n}"
            }
          }
        }
      ]
    }
  ]
}
